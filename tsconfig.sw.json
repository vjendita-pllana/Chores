{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.sw.tsbuildinfo",
    "target": "es2023",
    "lib": [
      "ES2023",
      "WebWorker"
    ],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": [
      "vite-plugin-pwa/client"
    ],
    "skipLibCheck": true,
    "strict": true,
    "composite": true,
    "emitDeclarationOnly": true,
    "outDir": "node_modules/.tmp/sw"
  },
  "include": [
    "src/sw.ts"
  ]
}